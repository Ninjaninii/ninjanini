  }

  .prose .lead-pill {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .prose .lead-pill b {
    color: var(--ink);
  }
  .pill {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    color: var(--jx-strong);
    padding: 5px 14px;
    border-radius: 99px;
