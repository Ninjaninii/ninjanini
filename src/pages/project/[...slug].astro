---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkMeta from '../../components/WorkMeta.astro';
import type { GetStaticPaths } from 'astro';

type Props = { entry: CollectionEntry<'project'> };

export const getStaticPaths: GetStaticPaths = async () => {
  // drafts render in dev only, so a case study can be previewed before it is listed
  const entries = await getCollection('project', ({ data }) => !data.draft || import.meta.env.DEV);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <article>
    <header class="sec sec--tight whead">
      <div class="shell">
        <p class="backrow reveal">
          <a class="back" href="/project"><span aria-hidden="true">&#8592;</span> Projects</a>
        </p>

        {d.metric && <span class="eyebrow reveal" data-delay="40" style="margin-top:24px"><i></i>{d.metric}</span>}

        <div class={d.heroImage ? 'herogrid' : undefined}>
          <div>
            <h1 class="display reveal" data-delay="80" style="margin-top:20px; font-size:clamp(40px,7vw,82px)">
              {
                d.phonetic ? (
                  <>
                    {[...d.title].slice(0, d.phonetic.length).map((ch, i) => (
                      <ruby>
                        {ch}
                        <rt>{d.phonetic![i]}</rt>
                      </ruby>
                    ))}
                    {[...d.title].slice(d.phonetic.length).join('')}
                  </>
                ) : (
                  d.title
                )
              }
              {d.titleMark && <span class="titlemark" aria-hidden="true"><img src={d.titleMark} alt="" /></span>}
            </h1>

            <p class="hook reveal" data-delay="140">{d.hook}</p>
          </div>

          {d.heroImage && <img class="heroimg reveal" data-delay="180" src={d.heroImage} alt={d.heroAlt ?? ''} />}
        </div>

        <div class="reveal" data-delay="200">
          <WorkMeta data={d} />
        </div>
      </div>
    </header>

    {
      d.cover && !d.heroImage && !d.coverCutout && (
        <div class="shell reveal">
          <div class="plate plate--wide">
            <div class="plate__in">
              <img src={d.cover} alt={d.coverAlt ?? ''} width="1600" height="1000" />
            </div>
          </div>
        </div>
      )
    }

    <div class="shell">
      <div class="prose reveal">
        <Content />
      </div>

      {
        d.link && (
          <p style="margin-top:40px">
            <a class="btn" href={d.link} rel="noopener" target="_blank">
              View the project
              <span class="btn__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </p>
        )
      }
    </div>
  </article>
</Base>

<script>
  // case-study motion: each block rises in as it scrolls into view, the parts inside a
  // figure follow one by one, and the interview donut draws itself while its number counts up.
  // Nothing is hidden unless this runs, and it never runs for reduced-motion users.
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!prose) return;
    const STAGGER =
      '.chips > span, .goals > *, .layers > *, .split__one, .split__fork, .split__two > *, .formula > *, .loop > *, .chain > *, .shift > *, .shift__label, .crowd > *, .scenes > div, .persona__traits li, .vflow li, ' +
      '.match > *, .seq li, .shots > figure, .cmp > *, .hmw';
    prose.querySelectorAll<HTMLElement>('.fig').forEach((fig) => {
      fig.querySelectorAll<HTMLElement>(STAGGER).forEach((el, i) => el.style.setProperty('--i', String(Math.min(i, 14))));
    });
    document.documentElement.classList.add('motion');

    const drawDonut = (svg: SVGSVGElement) => {
      const C = 2 * Math.PI * 48;
      svg.querySelectorAll('circle').forEach((circle, n) => {
        const final = circle.getAttribute('stroke-dasharray') ?? '';

        circle.animate(
          [{ strokeDasharray: `0 ${C}` }, { strokeDasharray: final }],
          { duration: 2200, delay: 500 + n * 1500, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'backwards' }
        );
      });
      const label = svg.querySelector('.donut__c');
      const match = label?.textContent?.match(/^(\d+)(.*)$/);
      if (label && match) {
        const target = Number(match[1]);
        const rest = match[2];
        const start = performance.now();
        const tick = (t: number) => {
          const k = Math.min((t - start - 500) / 2200, 1);
          label.textContent = `${Math.max(0, Math.round(target * (1 - Math.pow(1 - Math.max(k, 0), 3))))}${rest}`;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          el.querySelectorAll<SVGSVGElement>('.research__chart svg').forEach(drawDonut);
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
    );
    prose.querySelectorAll(':scope > *').forEach((el) => io.observe(el));
  })();
</script>

<script>
  // carousels written as raw HTML in case studies: prev / next buttons and a page counter
  document.querySelectorAll<HTMLElement>('.car').forEach((car) => {
    const track = car.querySelector<HTMLElement>('.car__track')!;
    const slides = track.children.length;
    const count = car.querySelector<HTMLElement>('.car__count');
    const page = () => Math.round(track.scrollLeft / track.clientWidth);
    const update = () => {
      if (count) count.textContent = `${page() + 1} / ${slides}`;
    };
    car.querySelector('.car__prev')?.addEventListener('click', () =>
      track.scrollTo({ left: Math.max(page() - 1, 0) * track.clientWidth, behavior: 'smooth' })
    );
    car.querySelector('.car__next')?.addEventListener('click', () =>
      track.scrollTo({ left: Math.min(page() + 1, slides - 1) * track.clientWidth, behavior: 'smooth' })
    );
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>

<style>
  .whead {
    padding-top: clamp(70px, 10vw, 130px);
  }
  .backrow {
    margin: 0 0 26px;
  }
  .back {
    font-size: 13.5px;
    color: var(--ink-2);
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    transition: color 0.5s var(--ease), gap 0.5s var(--ease);
  }
  .back:hover {
    color: var(--ink);
    gap: 12px;
  }
  ruby {
    ruby-position: over;
  }
  rt {
    font-size: 0.2em;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transform: translateY(-0.2em);
  }
  .titlemark {
    position: relative;
    z-index: -1;
    display: inline-block;
    width: 0.62em;
    margin-left: 0.12em;
    vertical-align: 0.05em;
  }
  .titlemark img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 78% 18%;
  }
  /* the koi rises out of the "water" below the title, swims behind the letters with its
     body flexing, and settles after the name; a ripple marks where it stops */
  @media (prefers-reduced-motion: no-preference) {
    .titlemark {
      animation: koi-path 4.2s cubic-bezier(0.25, 0.6, 0.3, 1) 0.8s both;
    }
    .titlemark img {
      animation:
        koi-flex 0.62s ease-in-out 0.8s 7 alternate,
        koi-flex-idle 2.8s ease-in-out 5.2s infinite alternate;
    }
    .titlemark::after {
      content: '';
      position: absolute;
      left: 30%;
      top: 45%;
      width: 1em;
      height: 0.34em;
      border-radius: 50%;
      border: 1px solid #c0613a;
      transform: translate(-50%, -50%) scale(0.2);
      opacity: 0;
      animation: koi-ripple 1.8s ease-out 4.6s both;
    }
  }
  @keyframes koi-path {
    0% {
      opacity: 0;
      filter: blur(5px);
      transform: translate(-7.2em, 1.1em) rotate(40deg) scale(0.62);
    }
    18% {
      opacity: 0.55;
      filter: blur(2px);
    }
    40% {
      opacity: 0.9;
      filter: blur(0);
      transform: translate(-4.6em, 0.35em) rotate(22deg) scale(0.82);
    }
    65% {
      transform: translate(-2em, -0.2em) rotate(4deg) scale(0.95);
    }
    85% {
      transform: translate(-0.35em, 0.08em) rotate(-6deg) scale(1);
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @keyframes koi-flex {
    from {
      transform: rotate(-7deg) skewX(4deg);
    }
    to {
      transform: rotate(7deg) skewX(-4deg);
    }
  }
  @keyframes koi-flex-idle {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(3deg) translateY(-0.03em);
    }
  }
  @keyframes koi-ripple {
    0% {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(0.2);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(2.4);
    }
  }
  .hook {
    font-size: clamp(19px, 2.5vw, 27px);
    line-height: 1.33;
    letter-spacing: -0.025em;
    max-width: 24ch;
    margin-top: 24px;
  }
  .herogrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }
  .heroimg {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 760px) {
    .herogrid {
      grid-template-columns: 1fr;
    }
    .heroimg {
      max-width: 420px;
      margin-top: 8px;
    }
  }
  .plate--wide {
    background: var(--plate);
    border: 1px solid var(--hair-2);
    border-radius: var(--radius);
    padding: 8px;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .plate--wide .plate__in {
    border-radius: var(--radius-inner);
    overflow: hidden;
    background: var(--panel);
  }
  .prose {
    padding-bottom: clamp(50px, 7vw, 90px);
  }
</style>

<style is:global>
  /* ── markdown body ── */
  .prose > * {
    max-width: var(--measure);
  }
  .prose h2 {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 500;
    margin: clamp(48px, 6vw, 84px) 0 14px;
  }
  .prose h2::before {
    content: '';
    display: block;
    width: 26px;
    height: 1px;
    background: var(--accent);
    margin-bottom: 14px;
  }
  .prose p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .prose p > strong:first-child {
    color: var(--ink);
    font-weight: 600;
  }
  .prose ul,
  .prose ol {
    color: var(--ink-2);
    padding-left: 20px;
    margin: 0 0 16px;
    font-size: 16.5px;
  }
  .prose li {
    margin-bottom: 9px;
    padding-left: 4px;
  }
  .prose li::marker {
    color: var(--ink-3);
  }
  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose blockquote {
    margin: 30px 0;
    padding: 2px 0 2px 24px;
    border-left: 2px solid var(--accent);
  }
  .prose blockquote p {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.35;
    color: var(--ink);
  }
  .prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 15px;
    margin: 22px 0;
    background: var(--panel);
    border: 1px solid var(--hair-2);
    border-radius: 14px;
    overflow: hidden;
  }
  .prose th,
  .prose td {
    padding: 11px 15px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hair-2);
  }
  .prose tr:last-child th,
  .prose tr:last-child td {
    border-bottom: 0;
  }
  .prose th {
    font-weight: 500;
    color: var(--ink);
  }
  .prose td {
    color: var(--ink-2);
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--hair-2);
    margin: clamp(44px, 6vw, 70px) 0 24px;
  }
  .prose > p:last-child em {
    font-size: 13.5px;
    color: var(--ink-3);
    font-style: normal;
  }

  /* draft-only note: marks what a case study still needs */
  .prose .todo {
    font-size: 14px;
    color: var(--ink-2);
    padding: 12px 16px;
    border: 1px dashed var(--accent);
    border-radius: 10px;
    background: var(--accent-soft);
    margin: 18px 0 24px;
  }

  /* ── figures written as raw HTML in the markdown ── */
  .prose .fig {
    margin: 30px 0 34px;
    padding: 22px 22px 18px;
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--lift);
  }
  /* a figure without a subtitle still needs air under its title */
  .fig__t + div,
  .fig__t + ol {
    margin-top: 18px;
  }
  .fig__t {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .fig__s {
    display: block;
    font-size: 13px;
    color: var(--ink-3);
    margin: 3px 0 20px;
  }
  .fig__src {
    display: block;
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 16px;
  }
  .fig details {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .fig summary {
    cursor: pointer;
    width: max-content;
  }
  .fig summary:hover {
    color: var(--ink);
  }
  .prose .fig table {
    font-size: 13px;
    margin: 10px 0 0;
  }
  .prose .fig th,
  .prose .fig td {
    padding: 7px 11px;
  }
  .fig .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .fig__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 12.5px;
    color: var(--ink-2);
    margin: -6px 0 16px;
  }
  .fig__legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  /* hover / focus tooltip on any mark that carries data-tip */
  .fig [data-tip] {
    position: relative;
    outline: none;
  }
  .fig [data-tip]:hover::after,
  .fig [data-tip]:focus-visible::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    width: max-content;
    max-width: 230px;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    text-align: left;
    white-space: normal;
    z-index: 5;
    pointer-events: none;
  }
  .fig [data-tip]:focus-visible {
    box-shadow: 0 0 0 2px var(--panel), 0 0 0 4px var(--accent);
  }

  /* column charts (also used for the waterfall) */
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .cols__t {
    display: block;
    font-size: 12.5px;
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  .plot {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    height: 170px;
    border-bottom: 1px solid var(--hair);
    background: repeating-linear-gradient(to top, var(--hair-2) 0 1px, transparent 1px 42.5px);
  }
  .plot__c {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    flex: 1;
    min-width: 0;
  }
  .plot__v {
    font-size: 12.5px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: 6px;
    white-space: nowrap;
  }
  .plot__b {
    width: 26px;
    border-radius: 4px 4px 0 0;
    cursor: default;
  }
  .plot--wf .plot__b {
    border-radius: 4px;
  }
  .plot__x {
    display: flex;
    justify-content: space-around;
    font-size: 11.5px;
    color: var(--ink-3);
    line-height: 1.35;
    margin-top: 8px;
    text-align: center;
  }
  .plot__x span {
    flex: 1;
    min-width: 0;
  }

  /* treemap */
  .tree {
    display: flex;
    gap: 2px;
    height: 250px;
    font-size: 12px;
    line-height: 1.35;
  }
  .tree__col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tree__t {
    border-radius: 4px;
    padding: 10px 11px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 34px;
    min-width: 0;
    color: var(--ink);
    cursor: default;
  }
  .tree__t.on {
    color: var(--seq-on);
  }
  .tree__t b {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .tree__t.big b {
    font-size: clamp(26px, 4vw, 36px);
  }
  .tree__t.row {
    flex-direction: row;
    align-items: center;
    padding: 4px 11px;
  }

  /* donut */
  .donut {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .donut svg {
    width: 170px;
    height: 170px;
    flex: none;
  }
  .donut__c {
    font-size: 21px;
    font-weight: 500;
    fill: var(--ink);
  }
  .donut__s {
    font-size: 8.5px;
    fill: var(--ink-3);
  }
  .donut ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .prose .donut li {
    margin: 0;
    padding: 0;
  }
  .donut li b {
    display: inline-block;
    min-width: 52px;
    color: var(--ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .donut li i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 8px;
    vertical-align: -1px;
  }

  /* images and video inside a figure */
  .fig__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-inner);
    background: var(--plate);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .prose .shots figure {
    margin: 0;
  }
  .shots img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-inner);
  }
  .shots figcaption {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink-2);
    margin-top: 8px;
  }

  /* one left edge for everything: label, lead, body text and figures all start on the same line.
     Text keeps a readable measure; figures run the full width. */
  .prose > * {
    max-width: 68ch;
  }
  .prose > .fig,
  .prose > hr {
    max-width: none;
  }
  .prose > h2 {
    margin: clamp(72px, 9vw, 120px) 0 18px;
  }
  .prose > h2:first-child {
    margin-top: clamp(24px, 4vw, 48px);
  }
  /* the bold opening of a section reads as its headline */
  .prose > h2 + p > strong:first-child {
    display: block;
    font-size: clamp(22px, 2.5vw, 30px);
    line-height: 1.22;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
    margin-bottom: 26px;
  }
  @media (min-width: 1100px) {
    .prose > h2 + p > strong:first-child {
      white-space: nowrap;
    }
    /* quotes also hold to a single line where there is room */
    .prose > blockquote {
      max-width: none;
    }
  }
  .prose > h2 + .jx-name {
    margin-top: 0;
  }
  .prose > .fig {
    margin: 32px 0 40px;
  }
  .prose > h2 + .fig {
    margin-top: 6px;
  }
  .prose > .fig + p {
    margin-top: 8px;
  }
  .prose > blockquote {
    margin: 36px 0 8px;
  }

  /* project palette: a case study can tint its figures to its own brand */
  .prose {
    --lift: 0 1px 2px rgba(35, 35, 33, 0.04), 0 14px 34px -16px rgba(35, 35, 33, 0.16);
    --glow: 0 1px 2px rgba(165, 74, 42, 0.08), 0 14px 30px -14px rgba(192, 97, 58, 0.45);
  }
  .prose .jx {
    --accent: #c0613a;
    --g-1: #ecd5c6;
    --jx-ink: #6b5444;
    /* Jianxu: beige card, lighter raised tiles; shadows, not fills, separate the layers */
    --paper: #f3efe8;
    --paper-2: #f9f7f3;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose .jx {
      --accent: #e08a62;
      --g-1: #4a3a31;
      --jx-ink: #d9bfae;
      --paper: #1f1d16;
      --paper-2: #2a2720;
    }
  }
  :root[data-theme='dark'] .prose .jx {
    --accent: #e08a62;
    --g-1: #4a3a31;
    --jx-ink: #d9bfae;
    --paper: #1f1d16;
    --paper-2: #2a2720;
  }
  :is(.jx, .bn) :is(.scenes > div, .chain > div:not(.on), .match > div:not(.on), .seq li,
  .cmp__c:not(.on):not(.cmp__c--gap), .vflow li:not(.on):not(.off), .goals > div, .layers > div,
  .split__one, .split__two > div, .formula > div:not(.on), .loop > div) {
    box-shadow: 0 1px 2px rgba(35, 35, 33, 0.04), 0 8px 18px -12px rgba(35, 35, 33, 0.18);
  }
  /* a case study with Jianxu figures takes the same ivory-beige for the whole page,
     so cards and page share one colour and only shadows separate them */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']):has(.prose .jx) {
      --accent: #c0613a;
      --paper: #f3efe8;
      --paper-2: #f9f7f3;
    }
  }
  :root[data-theme='light']:has(.prose .jx) {
    --accent: #c0613a;
    --paper: #f3efe8;
    --paper-2: #f9f7f3;
  }
  /* Binance case study: warm paper with a muted exchange gold; same layering rules as Jianxu */
  .prose .bn {
    --accent: #c4950f;
    --jx-strong: #8a6400;
    --jx-soft: #f6ebc8;
    --g-1: #e6e0cf;
    --g-2: #cdc4ab;
    --seq-1: #f4e9c6;
    --seq-2: #e3c66e;
    --seq-3: #c4950f;
    --seq-4: #7d5b00;
    --seq-on: #fffaf0;
    --glow: 0 1px 2px rgba(138, 100, 0, 0.08), 0 14px 30px -14px rgba(196, 149, 15, 0.5);
    --paper: #f2f0ea;
    --paper-2: #f9f8f4;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose .bn {
      --accent: #e2b84a;
      --jx-strong: #e9c86a;
      --jx-soft: #3a3220;
      --g-1: #3a372e;
      --g-2: #57513f;
      --seq-1: #3a3220;
      --seq-2: #6b5a26;
      --seq-3: #b08a24;
      --seq-4: #e2b84a;
      --seq-on: #17150f;
      --paper: #1d1b15;
      --paper-2: #27241d;
    }
  }
  :root[data-theme='dark'] .prose .bn {
    --accent: #e2b84a;
    --jx-strong: #e9c86a;
    --jx-soft: #3a3220;
    --g-1: #3a372e;
    --g-2: #57513f;
    --seq-1: #3a3220;
    --seq-2: #6b5a26;
    --seq-3: #b08a24;
    --seq-4: #e2b84a;
    --seq-on: #17150f;
    --paper: #1d1b15;
    --paper-2: #27241d;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']):has(.prose .bn) {
      --accent: #c4950f;
      --paper: #f2f0ea;
      --paper-2: #f9f8f4;
    }
  }
  :root[data-theme='light']:has(.prose .bn) {
    --accent: #c4950f;
    --paper: #f2f0ea;
    --paper-2: #f9f8f4;
  }
  :has(.prose .bn) .prose {
    --jx-strong: #8a6400;
    --jx-soft: #f6ebc8;
  }

  /* shared small labels for the Binance diagrams */
  :is(.goals, .layers, .split, .formula, .loop) small {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jx-strong);
    margin-bottom: 6px;
  }
  :is(.goals, .layers, .split, .formula, .loop) b {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  :is(.goals, .layers, .split, .formula, .loop) span {
    display: block;
    margin-top: 4px;
    font-size: 13.5px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* the brief: two goals */
  .goals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .goals > div {
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .goals b {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  /* first answer: the competitive layers */
  .layers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .layers > div {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  /* the turn: one customer splits into two */
  .split__one {
    max-width: 420px;
    margin: 0 auto;
    padding: 14px 18px;
    border-radius: 12px;
    background: transparent;
    text-align: center;
  }
  .split__one b {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }
  .split__fork {
    display: block;
    width: 52%;
    height: 34px;
    margin: 6px auto;
    border: 1.5px solid var(--accent);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
  }
  .split__two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .split__two > div {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .split__two > div.on {
    background: var(--jx-soft);
    box-shadow: var(--glow);
  }
  .split__two dl {
    margin: 10px 0 0;
    display: grid;
    gap: 6px;
    font-size: 13.5px;
  }
  .split__two dl > div {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 10px;
  }
  .split__two dt {
    color: var(--ink-3);
  }
  .split__two dd {
    margin: 0;
    color: var(--ink);
  }
  /* the plan: volume = users x amount x frequency */
  .formula {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) auto minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 10px;
    align-items: stretch;
  }
  .formula > div {
    padding: 16px 16px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .formula > div.on {
    background: var(--accent);
    box-shadow: var(--glow);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .formula > div.on small,
  .formula > div.on b {
    color: #fffaf0;
  }
  .formula > div.on b {
    font-size: 20px;
  }
  .formula i {
    align-self: center;
    font-style: normal;
    font-size: 20px;
    color: var(--accent);
  }
  /* a numbered list of steps without the question column */
  .prose .seq.seq--plain li {
    grid-template-columns: 26px 300px minmax(0, 1fr);
  }
  .prose .seq.seq--plain span {
    grid-column: auto;
  }
  @media (max-width: 760px) {
    .prose .seq.seq--plain li {
      grid-template-columns: 26px minmax(0, 1fr);
    }
    .prose .seq.seq--plain li > * {
      grid-column: 2;
    }
  }

  /* the habit loop: three steps that repeat */
  .loop {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    position: relative;
  }
  .loop > div {
    position: relative;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .loop > div:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -21px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
  }
  .loop__back {
    display: block;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--jx-strong);
    text-align: center;
  }
  @media (max-width: 760px) {
    .goals,
    .layers,
    .split__two,
    .loop {
      grid-template-columns: 1fr;
    }
    .split__fork {
      display: none;
    }
    .formula {
      grid-template-columns: 1fr;
    }
    .formula i {
      justify-self: center;
    }
    .loop > div:not(:last-child)::after {
      right: 50%;
      top: auto;
      bottom: -24px;
      transform: rotate(90deg);
    }
  }

  .jx .shots figcaption {
    color: var(--jx-ink);
  }
  .shots figcaption b {
    display: block;
    font-weight: 600;
  }
  .shots--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 640px) {
    .shots--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .prose .donut ul {
    flex: 1 1 220px;
  }
  .prose .donut {
    flex-wrap: nowrap;
  }
  @media (max-width: 520px) {
    .prose .donut {
      flex-wrap: wrap;
    }
  }
  .prose .jx-name {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(19px, 2.2vw, 24px);
    color: var(--ink);
    margin: 4px 0 18px;
  }
  .jx-name span {
    font-style: normal;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8em;
    color: var(--ink-3);
    margin: 0 10px;
  }

  /* Jianxu: brand colours and the small diagrams in its case study */
  .prose {
    --jx-strong: #a54a2a;
    --jx-soft: #f7e8de;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose {
      --jx-strong: #e3a07c;
      --jx-soft: #3a2b23;
    }
  }
  :root[data-theme='dark'] .prose {
    --jx-strong: #e3a07c;
    --jx-soft: #3a2b23;
  }
  .prose .jx-topic {
    color: var(--jx-strong);
    font-weight: 600;
    line-height: 1.55;
  }
  .prose .jx-topic small {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .jx-koi {
    display: inline-block;
    width: 34px;
    height: auto;
    vertical-align: middle;
    margin-left: 10px;
  }
  .hmw {
    display: grid;
    justify-items: center;
    margin-top: 6px;
  }
  .hmw > i {
    font-style: normal;
    color: var(--accent);
    font-size: 20px;
    margin-bottom: 6px;
  }
  .hmw > div {
    width: 100%;
    text-align: left;
    padding: 18px 22px;
    border-radius: 12px;
    background: #6b5444;
    box-shadow: 0 1px 2px rgba(60, 40, 30, 0.12), 0 16px 32px -16px rgba(60, 40, 30, 0.5);
  }
  .prose .hmw small {
    color: #ebc9b7;
  }
  .prose .hmw b {
    color: #faf6ef;
  }
  .hmw small,
  .chain small,
  .match small,
  .vflow small,
  .seq small,
  .cmp small,
  .persona__traits small,
  .scenes em {
    display: block;
    font-size: 11px;
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jx-strong);
    margin-bottom: 4px;
  }
  .hmw b {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.35;
    color: var(--ink);
  }

  /* research: donut beside the three ways people described it */
  .research {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .research__chart svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .prose .research__legend {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .prose .research__legend li {
    margin: 0 0 4px;
    padding: 0;
    white-space: nowrap;
  }
  .research__legend i {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 3px;
    margin-right: 6px;
  }
  .research__legend b {
    color: var(--ink);
    font-weight: 600;
    margin-right: 4px;
  }
  .scenes {
    display: grid;
    gap: 10px;
  }
  .scenes__t {
    font-size: 13px;
    color: var(--ink-3);
  }
  .scenes > div {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .prose .scenes p {
    margin: 0;
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 17px;
