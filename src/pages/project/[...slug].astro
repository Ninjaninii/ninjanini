    box-shadow: inset 0 0 0 1px #c0613a;
  }
  .vflow__src {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    font-style: normal;
    color: var(--ink-3);
  }

  /* the obvious answer: a crowded column beside an empty one */
  .crowd {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }
  .crowd__arrow {
    align-self: center;
    font-style: normal;
    font-size: 20px;
    color: var(--accent);
  }
  .crowd > div {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--paper-2);
  }
  .crowd small {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jx-strong);
    margin-bottom: 12px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips span {
    padding: 6px 12px;
    border-radius: 99px;
    background: var(--paper);
    box-shadow: var(--lift);
    font-size: 13px;
    color: var(--ink-2);
  }
  .chips span.on {
    background: var(--jx-soft);
    box-shadow: var(--glow);
    color: var(--ink);
    font-weight: 500;
  }
  .crowd > .crowd__empty {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--g-1);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .crowd__empty b {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .crowd__empty span {
    font-size: 13.5px;
    color: var(--ink-3);
    margin-top: 2px;
  }

  /* the reframe: from prevention to repair */
  .shift__label {
    margin: 34px 0 12px !important;
    font-size: 11px !important;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3) !important;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .shift__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--hair);
  }
  .shift {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 16px;
    margin-bottom: 30px;
  }
  .shift > div {
    padding: 16px 18px;
    border-radius: 12px;
  }
  .shift__from {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--hair);
  }
  .shift__from b {
    color: var(--ink-3) !important;
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }
  .shift__to {
    background: var(--accent);
    box-shadow: var(--glow);
  }
  .shift__to small,
  .shift__to span {
    color: #f7e3d6 !important;
  }
  .shift__to b {
    color: #fffaf5 !important;
  }
  .shift i {
    align-self: center;
    font-style: normal;
    color: var(--accent);
    font-size: 22px;
  }
  .shift small {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jx-strong);
  }
  .shift b {
    display: block;
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    margin-top: 4px;
  }
  .shift span {
    font-size: 13px;
    color: var(--ink-3);
  }
  .chain {
    margin-bottom: 4px;
  }
  @media (max-width: 760px) {
    .crowd,
    .shift {
      grid-template-columns: 1fr;
    }
    .crowd__arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
    .shift i {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  /* iteration, top to bottom */
  .vflow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  .prose .vflow li {
    position: relative;
    margin: 0 0 0 34px;
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--paper-2);
    max-width: 620px;
    color: var(--ink);
  }
  .vflow li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 20px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .vflow li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: -21px;
    top: 34px;
    bottom: -36px;
    width: 1.5px;
    background: linear-gradient(var(--accent), transparent);
    opacity: 0.6;
  }
  .vflow li.on {
    background: var(--jx-soft);
    box-shadow: var(--glow);
  }
  .vflow li.on::before {
    background: var(--accent);
  }
  .vflow li.off {
    background: transparent;
    box-shadow: var(--lift);
    color: var(--ink-3);
  }
  .vflow b,
  .seq b {
    display: block;
    font-weight: 600;
    font-size: 15.5px;
  }
  .vflow span {
    display: block;
    margin-top: 3px;
    font-size: 13.5px;
    font-weight: 300;
    color: var(--ink-2);
  }

  .chain,
  .match {
    display: grid;
    align-items: stretch;
    gap: 10px;
  }
  .chain {
    grid-template-columns: 1fr auto 1.2fr auto 1fr;
  }
  .match {
    grid-template-columns: 1fr auto 1.6fr;
  }
  .chain i,
  .match i {
    align-self: center;
    font-style: normal;
    color: var(--accent);
    font-size: 20px;
  }
  .chain > div,
  .match > div {
    background: var(--paper-2);
    border-radius: 12px;
    padding: 14px 16px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }
  .chain > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    font-size: clamp(16px, 1.8vw, 20px);
    min-height: 88px;
  }
  .chain > div.on,
  .match > div.on {
    background: var(--jx-soft);
    box-shadow: var(--glow);
  }
  .chain small {
    margin: 6px 0 0;
  }
  .match b {
    display: block;
    font-size: 14.5px;
    font-weight: 500;
  }

  /* the guided sequence: one line per step */
  .seq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    counter-reset: seq;
  }
  .prose .seq li {
    counter-increment: seq;
    display: grid;
    grid-template-columns: 26px 250px 20px 190px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--paper-2);
    white-space: nowrap;
  }
  .seq li::before {
    content: counter(seq);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--paper);
    background: var(--accent);
  }
  .seq i {
    font-style: normal;
    color: var(--accent);
  }
  .seq b {
    color: var(--ink);
  }
  .seq .seq__q {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
  }
  .seq span {
    font-size: 14px;
    color: var(--ink-2);
    font-weight: 300;
    white-space: normal;
  }
  @media (max-width: 1240px) {
    .prose .seq li {
