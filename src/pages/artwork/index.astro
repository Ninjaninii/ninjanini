---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const entries = (await getCollection('artwork', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year.localeCompare(a.data.year),
);
---

<Base
  title="Artwork"
  description="Installation, research and moving-image work by Chia Ni Chen."
>
  <section class="sec sec--tight">
    <div class="shell">
      <span class="eyebrow reveal"><i></i>Artwork</span>
      <h1 class="display reveal" data-delay="60" style="margin-top:22px; font-size:clamp(34px,5.6vw,64px)">
        Installation, research<br /><span class="serif-it">and moving image.</span>
      </h1>
      <p class="lede reveal" data-delay="130" style="margin-top:26px">
        Work that starts as a question I could not answer by reading.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="shell">
      {
        entries.length === 0 ? (
          <p class="lede">Nothing published yet.</p>
        ) : (
          <ul class="grid">
            {entries.map((entry, i) => (
              <WorkCard entry={entry} base="/artwork" delay={i * 70} />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(36px, 4.5vw, 64px) clamp(26px, 3vw, 44px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
