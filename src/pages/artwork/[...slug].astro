---
import { getCollection, type CollectionEntry } from 'astro:content';
import CaseStudy from '../../components/CaseStudy.astro';
import type { GetStaticPaths } from 'astro';

type Props = { entry: CollectionEntry<'artwork'> };

export const getStaticPaths: GetStaticPaths = async () => {
  // drafts render in dev only, so a case study can be previewed before it is listed
  const entries = await getCollection('artwork', ({ data }) => !data.draft || import.meta.env.DEV);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props as Props;
---

<CaseStudy entry={entry} />
