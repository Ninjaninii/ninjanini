---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="sec sec--tight">
    <div class="shell">
      <span class="eyebrow reveal"><i></i>404</span>
      <h1 class="display reveal" data-delay="60" style="margin-top:22px; font-size:clamp(34px,5.6vw,64px)">
        Page not found<span class="serif-it">.</span>
      </h1>
      <p class="lede reveal" data-delay="130" style="margin-top:26px">
        That page doesn't exist, or it moved. Try <a href="/">home</a>, <a href="/project">projects</a>,
        <a href="/artwork">artwork</a> or <a href="/about">about</a>.
      </p>
    </div>
  </section>
</Base>
