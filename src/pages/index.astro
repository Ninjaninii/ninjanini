---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site';

const projects = await getCollection('project', ({ data }) => !data.draft);
const artworks = await getCollection('artwork', ({ data }) => !data.draft);
const featured = [...projects, ...artworks]
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title={site.name}>
  <section class="hero">
    <div class="shell">
      <span class="eyebrow reveal"><i></i>Taipei &middot; Singapore</span>

      <h1 class="display hero__title reveal" data-delay="60">
        I design the thing,<br />then I make sure it<br />
        <span class="serif-it">actually gets built.</span>
      </h1>

      <div class="hero__grid">
        <p class="lede reveal" data-delay="140">
          Product and brand designer, final-year in Technology Art at <strong>National Tsing Hua
          University</strong>. I work from research through to the thing that ships &mdash; and I run the
          production too: budgets, vendors, install day.
        </p>

        <div class="hero__cta reveal" data-delay="200">
          <a class="btn" href="/project">
            See the work
            <span class="btn__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a class="btn btn--ghost" href={`mailto:${site.email}`}>
            Get in touch
            <span class="btn__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="shell">
      <div class="sec__head reveal">
        <h2>Selected work</h2>
        <a class="quiet" href="/project">All projects &#8594;</a>
      </div>

      {
        featured.length === 0 ? (
          <p class="lede">Case studies are going up one at a time.</p>
        ) : (
          <ul class="grid">
            {featured.map((entry, i) => (
              <WorkCard
                entry={entry}
                base={entry.collection === 'artwork' ? '/artwork' : '/project'}
                delay={i * 70}
              />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(80px, 13vw, 170px) 0 clamp(50px, 7vw, 90px);
  }
  .hero__title {
    margin: 26px 0 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: end;
    margin-top: clamp(34px, 4.5vw, 60px);
  }
  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }
  }
  .hero__cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-self: end;
  }
  @media (max-width: 860px) {
    .hero__cta {
      justify-self: start;
    }
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(36px, 4.5vw, 64px) clamp(26px, 3vw, 44px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .quiet {
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }
  .quiet:hover {
    color: var(--ink);
  }
</style>
