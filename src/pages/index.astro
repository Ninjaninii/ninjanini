---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkFolder from '../components/WorkFolder.astro';
import { site } from '../site';

const projects = await getCollection('project', ({ data }) => !data.draft);
const artworks = await getCollection('artwork', ({ data }) => !data.draft);
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
projects.sort(byOrder);
artworks.sort(byOrder);

// skills bubbles: every skill tag across the published work, and which pieces show it
const pieces = [
  ...projects.map((e) => ({ id: e.id, href: `/project/${e.id}/`, title: e.data.title, skills: e.data.skills })),
  ...artworks.map((e) => ({ id: e.id, href: `/artwork/${e.id}/`, title: e.data.title, skills: e.data.skills })),
];
// five skills that don't overlap; every piece's tags come from this list
const SKILLS = ['Research', 'Product design', 'Business strategy', 'Storytelling', 'Leadership'];
const skills = SKILLS.filter((name) => pieces.some((p) => p.skills.includes(name))).map((name) => ({
  name,
  works: pieces.filter((p) => p.skills.includes(name)).map((p) => p.id),
}));
---

<Base title={site.name}>
  <section class="hero">
    <div class="home-glow" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="shell">
      <span class="eyebrow reveal"><i></i>Taipei &middot; Singapore</span>

      <h1 class="display hero__title reveal" data-delay="60">
        I look for the problem<br />
        <span class="serif-it">behind the problem.</span>
      </h1>

      <div class="hero__grid">
        <p class="lede reveal" data-delay="140">
          Final-year in Technology and Art at <strong>National Tsing Hua University</strong>, on exchange at <strong>NUS</strong>
          in Singapore. In each project below, the first answer looked right and wasn't. I work across <strong>research</strong>,
          <strong>product design</strong> and <strong>marketing strategy</strong> to find out why, then design and ship what
          comes next.
        </p>

      </div>
    </div>
  </section>

  <section class="sec">
    <div class="shell">
      <div class="sec__head reveal">
        <h2>Selected work</h2>
        <a class="quiet" href="/project">All projects &#8594;</a>
      </div>

      <ul class="grid">
        <WorkFolder label="Projects" base="/project" entries={projects} empty="Case studies are going up one at a time." />
        <WorkFolder
          label="Artwork"
          base="/artwork"
          entries={artworks}
          empty="Installation, research and moving-image work is on its way."
          delay={70}
        />
      </ul>
    </div>
  </section>

  <section class="sec skills">
    <div class="shell">
      <div class="sec__head reveal">
        <h2>Skills, and where to see them</h2>
      </div>
      <p class="skills__hint reveal">Point at a skill to see the work behind it.</p>
      <ul class="bubbles reveal" data-delay="60">
        {
          skills.map((s) => (
            <li>
              <button type="button" class="bubble" data-works={s.works.join(' ')}>
                {s.name}
                <small>{s.works.length}</small>
              </button>
            </li>
          ))
        }
      </ul>
      <ul class="pieces reveal" data-delay="120">
        {
          pieces.map((p) => (
            <li>
              <a class="piece" href={p.href} data-work={p.id}>
                {p.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* the homepage wears mint: page, card trays and accent; dark mode keeps the site default */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']):has(.home-glow) {
      --paper: #f2f8f5;
      --paper-2: #e6f2ec;
      --plate: #d3e9de;
      --accent: #23866d;
      --accent-soft: rgba(53, 200, 180, 0.14);
    }
  }
  :root[data-theme='light']:has(.home-glow) {
    --paper: #f2f8f5;
    --paper-2: #e6f2ec;
    --plate: #d3e9de;
    --accent: #23866d;
    --accent-soft: rgba(53, 200, 180, 0.14);
  }
  /* a little more grain on the homepage, like risograph paper */
  :root:has(.home-glow) body::after {
    opacity: 0.05;
  }
</style>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(80px, 13vw, 170px) 0 clamp(50px, 7vw, 90px);
  }
  /* soft, out-of-focus light behind the hero: mist, mint and lemonade */
  .home-glow {
    position: absolute;
    inset: -10% 0 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .home-glow i {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }
  .home-glow i:nth-child(1) {
    width: 46vw;
    height: 30vw;
    right: -6vw;
    top: 8%;
    background: #c2f2e4;
  }
  .home-glow i:nth-child(2) {
    width: 26vw;
    height: 20vw;
    right: 18vw;
    top: 34%;
    background: #35c8b4;
    opacity: 0.22;
  }
  .home-glow i:nth-child(3) {
    width: 22vw;
    height: 16vw;
    right: 2vw;
    top: 52%;
    background: #edf7be;
    opacity: 0.6;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .home-glow {
      display: none;
    }
  }
  :root[data-theme='dark'] .home-glow {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .home-glow i {
      animation: glow-drift 18s ease-in-out infinite alternate;
    }
    .home-glow i:nth-child(2) {
      animation-duration: 23s;
      animation-direction: alternate-reverse;
    }
    .home-glow i:nth-child(3) {
      animation-duration: 27s;
    }
  }
  @keyframes glow-drift {
    to {
      transform: translate(-4vw, 3vw) scale(1.12);
    }
  }
  .hero__title {
    margin: 26px 0 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: end;
    margin-top: clamp(34px, 4.5vw, 60px);
  }
  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(36px, 4.5vw, 64px) clamp(26px, 3vw, 44px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .quiet {
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }
  .quiet:hover {
    color: var(--ink);
  }
  /* skills bubbles: a pill per skill, with how many pieces show it; pointing at a skill
     lights up its pieces below, pointing at a piece lights up its skills */
  .skills__hint {
    margin: -6px 0 26px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .bubbles,
  .pieces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .bubble {
    font: inherit;
    font-size: 17px;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 12px 14px 12px 22px;
    cursor: default;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 1px 2px rgba(35, 35, 33, 0.04), 0 10px 24px -16px rgba(35, 110, 95, 0.35);
    transition: background 0.35s var(--ease), color 0.35s var(--ease), opacity 0.35s var(--ease), transform 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .bubble small {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .pieces {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--hair);
    gap: 10px 28px;
  }
  .piece {
    display: inline-flex;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.35s var(--ease), opacity 0.35s var(--ease);
  }
  /* while something is pointed at, everything else steps back */
  .skills.is-active .bubble:not(.is-lit),
  .skills.is-active .piece:not(.is-lit) {
    opacity: 0.35;
  }
  .bubble.is-lit {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
    transform: translateY(-3px);
  }
  .bubble.is-lit small {
    background: rgba(255, 255, 255, 0.22);
    color: var(--paper);
  }
  .piece.is-lit {
    color: var(--accent);
  }
</style>

<script>
  // skills bubbles: light up the pieces behind a skill, or the skills behind a piece
  const box = document.querySelector<HTMLElement>('.skills');
  if (box) {
    const bubbles = [...box.querySelectorAll<HTMLElement>('.bubble')];
    const pieces = [...box.querySelectorAll<HTMLElement>('.piece')];
    const clear = () => {
      box.classList.remove('is-active');
      [...bubbles, ...pieces].forEach((el) => el.classList.remove('is-lit'));
    };
    // skill: light it and its pieces; work: light it and its skills
    const light = (skill: HTMLElement | null, work: string | null) => {
      clear();
      box.classList.add('is-active');
      bubbles.forEach((b) => {
        const ws = b.dataset.works!.split(' ');
        b.classList.toggle('is-lit', b === skill || (work !== null && ws.includes(work)));
      });
      pieces.forEach((p) => p.classList.toggle('is-lit', skill ? skill.dataset.works!.split(' ').includes(p.dataset.work!) : p.dataset.work === work));
    };
    bubbles.forEach((b) => {
      b.addEventListener('pointerenter', () => light(b, null));
      b.addEventListener('focus', () => light(b, null));
      // a tap on a phone lights it; a second tap on the same bubble clears it
      b.addEventListener('click', () => {
        if (box.dataset.tapped === b.textContent) {
          clear();
          delete box.dataset.tapped;
        } else {
          light(b, null);
          box.dataset.tapped = b.textContent!;
        }
      });
    });
    pieces.forEach((p) => {
      p.addEventListener('pointerenter', () => light(null, p.dataset.work!));
      p.addEventListener('focus', () => light(null, p.dataset.work!));
    });
    box.querySelectorAll('.bubbles, .pieces').forEach((list) => list.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') clear();
    }));
    box.addEventListener('focusout', (e) => { if (!box.contains(e.relatedTarget as Node)) clear(); });
  }
</script>
