---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site';

const projects = await getCollection('project', ({ data }) => !data.draft);
const artworks = await getCollection('artwork', ({ data }) => !data.draft);
const featured = [...projects, ...artworks]
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title={site.name}>
  <section class="hero">
    <div class="home-glow" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="shell">
      <span class="eyebrow reveal"><i></i>Taipei &middot; Singapore</span>

      <h1 class="display hero__title reveal" data-delay="60">
        I shape the strategy,<br />design the product,<br />
        <span class="serif-it">and make sure it gets built.</span>
      </h1>

      <div class="hero__grid">
        <p class="lede reveal" data-delay="140">
          Final-year in Technology and Art at <strong>National Tsing Hua University</strong>, now on
          exchange at <strong>NUS</strong> in Singapore. My work crosses <strong>data-driven marketing</strong>,
          <strong>product and UX design</strong>, and <strong>research</strong> &mdash; and I run the production
          that gets it out the door.
        </p>

        <div class="hero__cta reveal" data-delay="200">
          <a class="btn" href="/project">
            See the work
            <span class="btn__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a class="btn btn--ghost" href={`mailto:${site.email}`}>
            Get in touch
            <span class="btn__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="shell">
      <div class="sec__head reveal">
        <h2>Selected work</h2>
        <a class="quiet" href="/project">All projects &#8594;</a>
      </div>

      {
        featured.length === 0 ? (
          <p class="lede">Case studies are going up one at a time.</p>
        ) : (
          <ul class="grid">
            {featured.map((entry, i) => (
              <WorkCard
                entry={entry}
                base={entry.collection === 'artwork' ? '/artwork' : '/project'}
                delay={i * 70}
              />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style is:global>
  /* the homepage wears mint: page, card trays and accent; dark mode keeps the site default */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']):has(.home-glow) {
      --paper: #f2f8f5;
      --paper-2: #e6f2ec;
      --plate: #d3e9de;
      --accent: #23866d;
      --accent-soft: rgba(53, 200, 180, 0.14);
    }
  }
  :root[data-theme='light']:has(.home-glow) {
    --paper: #f2f8f5;
    --paper-2: #e6f2ec;
    --plate: #d3e9de;
    --accent: #23866d;
    --accent-soft: rgba(53, 200, 180, 0.14);
  }
  /* a little more grain on the homepage, like risograph paper */
  :root:has(.home-glow) body::after {
    opacity: 0.05;
  }
</style>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(80px, 13vw, 170px) 0 clamp(50px, 7vw, 90px);
  }
  /* soft, out-of-focus light behind the hero: mist, mint and lemonade */
  .home-glow {
    position: absolute;
    inset: -10% 0 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .home-glow i {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }
  .home-glow i:nth-child(1) {
    width: 46vw;
    height: 30vw;
    right: -6vw;
    top: 8%;
    background: #c2f2e4;
  }
  .home-glow i:nth-child(2) {
    width: 26vw;
    height: 20vw;
    right: 18vw;
    top: 34%;
    background: #35c8b4;
    opacity: 0.22;
  }
  .home-glow i:nth-child(3) {
    width: 22vw;
    height: 16vw;
    right: 2vw;
    top: 52%;
    background: #edf7be;
    opacity: 0.6;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .home-glow {
      display: none;
    }
  }
  :root[data-theme='dark'] .home-glow {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-glow i {
      animation: glow-drift 18s ease-in-out infinite alternate;
    }
    .home-glow i:nth-child(2) {
      animation-duration: 23s;
      animation-direction: alternate-reverse;
    }
    .home-glow i:nth-child(3) {
      animation-duration: 27s;
    }
  }
  @keyframes glow-drift {
    to {
      transform: translate(-4vw, 3vw) scale(1.12);
    }
  }
  .hero__title {
    margin: 26px 0 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: end;
    margin-top: clamp(34px, 4.5vw, 60px);
  }
  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }
  }
  .hero__cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-self: end;
  }
  @media (max-width: 860px) {
    .hero__cta {
      justify-self: start;
    }
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(36px, 4.5vw, 64px) clamp(26px, 3vw, 44px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .quiet {
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.5s var(--ease);
  }
  .quiet:hover {
    color: var(--ink);
  }
</style>
