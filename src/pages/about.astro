---
import Base from '../layouts/Base.astro';
import AboutRing from '../components/AboutRing.astro';
import { site } from '../site';

/*
 * Every entry below is a confirmed CV line from the master experience
 * workbook. Dates and titles must match it exactly — change them there first.
 * Taiwan-specific names carry a one-line gloss for a reader outside Taiwan.
 */
const education = [
  {
    org: 'National University of Singapore',
    role: 'Exchange student, Industrial Design',
    dates: 'Aug – Dec 2026',
    proof: 'Courses include Interaction Design and UX, and Product Design and Innovation.',
  },
  {
    org: 'National Tsing Hua University',
    role: 'B.A., Interdisciplinary Program of Technology and Art',
    dates: '2022 – Dec 2026',
    proof: 'Courses include Marketing Management, Statistics I and II, and User Experience Design.',
    note: 'One of Taiwan’s leading research universities.',
  },
];

// each role: the title, then one line of what changed because of the work
const experience = [
  {
    org: 'LINE Taiwan',
    role: 'B2B Marketing Intern, Brand Communication Group',
    dates: 'Aug 2025 – Mar 2026',
    proof: 'Analysed a year of data from 386 SME accounts. Healthcare beat Retail on engagement by 20%, so the next year’s plan moved to industry-specific marketing.',
    note: 'LINE is the dominant messaging platform in Taiwan, Japan and Thailand.',
  },
  {
    org: 'Tang Cheng Goose Restaurant',
    role: 'Freelance Marketing',
    dates: 'Sep 2026 – present',
    proof: 'Help run a LINE Official Account with 4,732 friends: messages, menus and the social media plan.',
  },
  {
    org: 'NTHU Consulting Group',
    role: 'Teaching Supervisor',
    dates: 'Aug 2025 – Jun 2026',
    proof: 'One of two TAs for a 5-person team that ranked 1st of all teams in a simulated consulting project.',
    note: 'A student consulting club.',
  },
  {
    org: 'NTHU Technology & Art Graduation Exhibition',
    role: 'Director of Public Relations',
    dates: 'Jul 2025 – May 2026',
    proof: 'Researched 216 potential sponsors and used past post data to choose whom to approach: 16 partners, about NT$150,000 in kind.',
  },
  {
    org: 'OpenHCI',
    role: 'Academic Team',
    dates: 'Mar – Jul 2026',
    proof: 'Designed the curriculum of a 6-day workshop for 60 participants, and mentored them in design thinking, presenting and Figma.',
    note: 'Organising team of Taiwan’s longest-running student HCI workshop.',
  },
  {
    org: 'NTHU Consulting Group',
    role: 'Director of Marketing',
    dates: 'Jul 2024 – Aug 2025',
    proof: 'Grew followers by 25% in a year; a recruitment campaign drew 75 applicants for 32 places.',
  },
  {
    org: 'Taipei Art Book Fair',
    role: 'Exhibition Coordination & Arts Administration Intern',
    dates: 'Apr – Jun 2025',
    proof: 'Set up the full exhibition in 3 weeks in a team of four, and built the team’s art-book database in Notion.',
  },
];

const recognition = [
  {
    org: 'TAICHI 2026',
    role: 'First author, poster and demo',
    dates: 'Aug 2026',
    proof: 'Douleur Minime: Material Speculation of the AI Between Us.',
    note: 'Taiwan’s annual conference on human–computer interaction.',
  },
  { org: 'OpenHCI 2025', role: 'Best Research Award', dates: 'Jul 2025', proof: 'For Jianxu, a focus-recovery concept grounded in the literature and 20 interviews.' },
  { org: 'NCCU Creative Ideas Hackathon', role: 'Innovation Star Award', dates: '2025', proof: 'For Wisely, among 32 teams. I built the business model and the projections.' },
];

// three strengths, each with evidence a stranger can check further down the page or in the work
const strengths = [
  {
    title: 'Find the real problem',
    body: 'Data and interviews before decisions. At LINE, 386 accounts changed a year’s plan; on Jianxu, 20 interviews set the new direction.',
  },
  {
    title: 'Make the numbers work',
    body: 'A business case behind the idea: Wisely’s break-even projection, and a sponsorship plan that brought in 16 partners.',
  },
  {
    title: 'Get it done with people',
    body: 'Leading and coaching teams: a workshop for 60 participants, a team I helped reach 1st.',
  },
];

// experience by kind of work; every entry is the same line as above, word for word
const pick = (org: string, role: string) => experience.find((e) => e.org === org && e.role === role)!;
const groups = [
  {
    label: 'Work',
    items: [pick('LINE Taiwan', 'B2B Marketing Intern, Brand Communication Group'), pick('Tang Cheng Goose Restaurant', 'Freelance Marketing')],
  },
  {
    label: 'Teaching',
    items: [pick('NTHU Consulting Group', 'Teaching Supervisor'), pick('OpenHCI', 'Academic Team')],
  },
  {
    label: 'Leading',
    items: [pick('NTHU Consulting Group', 'Director of Marketing'), pick('NTHU Technology & Art Graduation Exhibition', 'Director of Public Relations')],
  },
  { label: 'Exhibitions', items: [pick('Taipei Art Book Fair', 'Exhibition Coordination & Arts Administration Intern')] },
  { label: 'Education', items: education },
  { label: 'Recognition', items: recognition },
];
---

<Base
  colophon="Set in Bodoni Moda and Outfit. Logo designed by me."
  title="About"
  description="Chia Ni Chen: research, product design and marketing strategy. Technology and Art at NTHU, on exchange at NUS Singapore."
>
  <AboutRing />

  <section class="sec sec--tight about-top">
    <div class="shell">
      <div class="copy">
        <span class="eyebrow reveal"><i></i>About</span>
        <h1 class="display reveal" data-delay="60" style="margin-top:22px; font-size:clamp(34px,5.6vw,64px)">
          Say hi on <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>, or see what I’m <a class="serif-it" href="/artwork/">making</a>.
        </h1>
        <div class="intro">
          <p class="lede reveal" data-delay="130">I’m a designer from Taiwan, studying Technology and Art at National Tsing Hua University and now on exchange in Industrial Design at NUS.</p>
          <p class="lede reveal" data-delay="180">At LINE Taiwan, a year of data from 386 small-business accounts reshaped the next year’s marketing plan. Outside of studio, I make collages and paint, curate shows, travel, and look for vintage toys.</p>
          <p class="lede reveal" data-delay="230">I’m looking for product design roles first, then UX and marketing, and I’m always happy to meet people, so reach out.</p>
        </div>
      </div>

      <!-- the longer story, closed until asked for -->
      <details class="more reveal">
        <summary class="stamp stamp--btn">Read more</summary>
        <div class="note">
          <h2 class="group__label">Where I started</h2>
          <div class="note__body">
            <p>
              Art taught me to start from the audience. In an exhibition, I think about every object, material and space,
              and about what a visitor should feel the moment they walk in. A good piece lets people sense something in
              themselves: ideas collide, and they leave knowing themselves a little better.
            </p>
            <p>
              Products work the same way through a different medium. I watch how people actually behave, find what gets in
              their way, and refine the product until it serves them better. What I want from both is the same: to make
              people’s days a little better. Research is how I find out what would truly improve their lives, and that is
              why I work in design.
            </p>
          </div>
        </div>
        <ul class="strengths">
          {
            strengths.map((st) => (
              <li>
                <b>{st.title}</b>
                <p>{st.body}</p>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="shell">
      {
        groups.map((g) => (
          <div class="group reveal">
            <h2 class="group__label"><span class="stamp">{g.label}</span></h2>
            <ol class="cv">
              {g.items.map((it) => (
                <li class="cv__row">
                  <span class="cv__dates">{it.dates}</span>
                  <div class="cv__body">
                    <p class="cv__role">{it.role}</p>
                    <p class="cv__org">{it.org}</p>
                    {it.proof && <p class="cv__proof">{it.proof}</p>}
                    {it.note && <p class="cv__note">{it.note}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }

    </div>
  </section>
</Base>

<style>

  /* the copy sits beneath the ring: one centred column, the headline centred, the ledes left-aligned */
  .about-top {
    padding-top: 8px;
  }
  .copy {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .copy .intro {
    text-align: left;
  }
  .copy h1 a.serif-it {
    color: var(--accent);
  }
  /* the headline's links: quiet until pointed at */
  h1 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    text-decoration-color: var(--mint-300);
    transition: text-decoration-color 0.4s var(--ease), color 0.4s var(--ease);
  }
  h1 a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .intro .lede {
    font-size: 20px;
    line-height: 1.55;
  }
  /* Read more: closed by default; the stamp button opens the longer story */
  .more {
    margin-top: clamp(32px, 4vw, 48px);
  }
  .more summary {
    list-style: none;
    width: max-content;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more[open] summary {
    margin-bottom: 8px;
  }
  .group__label .stamp {
    font-size: var(--fs-label);
  }


  .intro {
    display: grid;
    gap: 18px;
    margin-top: 30px;
  }

  .strengths {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--hair);
  }
  .strengths li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 26px 26px;
  }
  .strengths li:first-child {
    padding-left: 0;
  }
  .strengths li + li {
    border-left: 1px solid var(--hair);
  }
  .strengths b {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .strengths p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .strengths {
      grid-template-columns: 1fr;
    }
    .strengths li {
      padding-inline: 0;
    }
    .strengths li + li {
      border-left: 0;
      border-top: 1px solid var(--hair);
    }
  }

  /* a short passage beside its label, on the same grid as the CV groups below */
  .note {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 28px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--hair-2);
  }
  .note--after {
    border-top: 0;
    padding-top: 0;
  }
  .note__body {
    display: grid;
    gap: 14px;
    max-width: 62ch;
  }
  .note__body p {
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .note {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 28px;
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--hair-2);
  }
  .group:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (max-width: 760px) {
    .group {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  .group__label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 4px;
  }

  .cv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .cv__row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 22px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair-2);
  }
  .cv__row:first-child {
    padding-top: 0;
  }
  .cv__row:last-child {
    border-bottom: 0;
  }
  @media (max-width: 560px) {
    .cv__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .cv__dates {
    font-size: 13px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .cv__role {
    font-size: 16.5px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .cv__org {
    font-size: 14.5px;
    color: var(--ink-2);
    margin-top: 2px;
  }
  .cv__proof {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    margin-top: 8px;
    max-width: 62ch;
  }
  .cv__note {
    font-size: 13px;
    color: var(--ink-3);
    margin-top: 4px;
  }
</style>
