---
import type { CollectionEntry } from 'astro:content';
import { listTitle } from '../lib/title';

type Entry = CollectionEntry<'project'> | CollectionEntry<'artwork'>;
interface Props {
  /** shown on the folder and as its heading, e.g. "Projects" */
  label: string;
  /** the list page this folder stands for, e.g. "/project" */
  base: string;
  entries: Entry[];
  /** what to say when the folder has nothing in it yet */
  empty: string;
  delay?: number;
}
const { label, base, entries, empty, delay = 0 } = Astro.props;
const items = entries.map((e) => ({
  href: `${base}/${e.id}/`,
  title: listTitle(e.data.title),
  summary: e.data.summary,
  tag: e.data.metric ? `${e.data.metric} · ${e.data.year}` : e.data.year,
  img: e.data.folderPapers?.[0] ?? e.data.cover ?? '',
  // a flat logo reads better small; screens and objects fill more of the sheet
  pad: e.data.folderPad,
}));
// an empty folder still holds three blank sheets, so it opens the same way
const sheets = items.length ? items : [null, null, null];
const isArtwork = base === '/artwork';
// the folder starts open with the first piece in front; the same fan the script draws
const fan = (i: number, current = 0) => {
  const k = i - current;
  const far = Math.abs(k);
  return `--i:${i};--k:${k};--ty:${k === 0 ? -92 : -62 + far * 6}%;--sc:${k === 0 ? 1 : 0.86};z-index:${10 - far}`;
};
---

<!--
  A section of the site as a folder, after the Framer "Folder" component: a back panel with a tab,
  sheets inside and a two-part front flap. It is open from the start, its sheets fanned out, one per
  piece of work, with the first in front and described below. With a mouse, moving across the folder
  picks a piece and a click opens it. On touch, tapping a side sheet brings it to the middle, tapping
  the middle one opens it, and a sideways swipe moves along.
-->
<li class="fcard reveal" data-delay={delay}>
  <div class="folder is-open" data-folder data-count={items.length}>
    <button class="folder__hit" type="button" aria-expanded="true" aria-label={`${label}: open the piece in front`}>
      <span class="folder__back">
        <span class="folder__tab" aria-hidden="true"></span>
        {
          sheets.map((it, i) => (
            <span class:list={['folder__paper', { 'is-current': i === 0 }]} data-paper={i} data-href={it?.href} style={fan(i)}>
              {it?.img && <img src={it.img} alt="" loading="lazy" style={it.pad ? `padding:${it.pad}%` : undefined} />}
            </span>
          ))
        }
        <span class="folder__front folder__front--l" aria-hidden="true"></span>
        <span class="folder__front folder__front--r" aria-hidden="true">
          <span class="folder__label">{label}</span>
        </span>
      </span>
    </button>
  </div>

  <div class="fcard__caption" aria-live="polite">
    {
      items.map((it, i) => (
        <div class="fcard__item" data-caption={i} hidden={i !== 0}>
          <span class="fcard__tag">{it.tag}</span>
          <h3>{it.title}</h3>
          <p>{it.summary}</p>
          <div class="fcard__row">
            <a class="fcard__go" href={it.href}>{isArtwork ? 'View the piece' : 'Read the case study'} <span aria-hidden="true">&#8594;</span></a>
            {items.length > 1 && (
              <span class="fcard__nav">
                <button type="button" data-step="-1" aria-label="Previous piece">‹</button>
                <span>{i + 1} / {items.length}</span>
                <button type="button" data-step="1" aria-label="Next piece">›</button>
              </span>
            )}
          </div>
        </div>
      ))
    }
    {
      !items.length && (
        <div class="fcard__item" data-caption="0">
          <span class="fcard__tag">Coming soon</span>
          <h3>{label}</h3>
          <p>{empty}</p>
        </div>
      )
    }
  </div>
</li>

<style>
  .fcard {
    list-style: none;
    display: grid;
    gap: 26px;
    align-content: start;
  }
  .folder {
    --folder: #86d3c6;
    --folder-edge: #6fc3b5;
    --w: 260px;
    --h: 208px;
    --r: 18px;
    --dur: 0.45s;
    --spread: 46%;
    height: calc(var(--h) + 150px);
    display: grid;
    place-items: end center;
    padding-bottom: 6px;
    /* sideways swipes belong to the folder; vertical ones still scroll the page */
    touch-action: pan-y;
  }
  .folder__hit {
    all: unset;
    cursor: pointer;
    display: block;
    transition: transform var(--dur) var(--ease);
  }
  .folder__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 10px;
    border-radius: var(--r);
  }
  .folder__back {
    position: relative;
    display: block;
    width: var(--w);
    height: var(--h);
    background: var(--folder-edge);
    border-radius: 0 var(--r) var(--r) var(--r);
    box-shadow: 0 6px 18px -6px rgba(35, 110, 95, 0.35);
  }
  .folder__tab {
    position: absolute;
    bottom: 98%;
    left: 0;
    width: 32%;
    height: 12%;
    background: var(--folder-edge);
    border-radius: calc(var(--r) / 2) calc(var(--r) / 2) 0 0;
  }

  /* sheets: stacked inside when closed, fanned out above the folder when open */
  /* the fan: each sheet sits --k places from the front one, --spread apart */
  .folder__paper {
    --tx: calc(-50% + var(--k, 0) * var(--spread));
    --ty: 10%;
    --rot: calc(var(--k, 0) * 11deg);
    --sc: 1;
    position: absolute;
    z-index: 2;
    bottom: 10%;
    left: 50%;
    width: 82%;
    height: 66%;
    border-radius: calc(var(--r) - 4px);
    overflow: hidden;
    isolation: isolate;
    /* one sheet of matte frosted glass: a faint mint tint, and whatever sits behind it
       (the other sheets, the folder, their shadows) shows through as a soft blur */
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.34), rgba(196, 236, 222, 0.22));
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    box-shadow: 0 16px 30px -18px rgba(40, 120, 100, 0.32);
    transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(var(--sc));
    transition: transform var(--dur) var(--ease), height var(--dur) var(--ease), box-shadow var(--dur);
  }
  /* a faint light along the top edge, no frame */
  .folder__paper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 28%);
    pointer-events: none;
  }
  .folder__paper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 13%;
    box-sizing: border-box;
    pointer-events: none;
    display: block;
    filter: drop-shadow(0 8px 14px rgba(40, 120, 100, 0.22));
  }
  .folder__front {
    position: absolute;
    z-index: 3;
    left: 0;
    width: 100%;
    top: 12%;
    height: 88%;
    background: var(--folder);
    border-radius: calc(var(--r) - 5px) var(--r) var(--r) var(--r);
    transform-origin: bottom;
    transition: transform var(--dur) var(--ease);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
  .folder__label {
    position: absolute;
    left: 18px;
    bottom: 16px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #1f5a50;
  }

  @media (hover: hover) {
    .folder:not(.is-open):hover .folder__hit {
      transform: translateY(-8px);
    }
    .folder:not(.is-open):hover .folder__paper {
      --ty: 0%;
    }
    .folder:not(.is-open):hover .folder__front--l {
      transform: skew(15deg) scaleY(0.6);
    }
    .folder:not(.is-open):hover .folder__front--r {
      transform: skew(-15deg) scaleY(0.6);
    }
  }
  .folder.is-open .folder__front--l {
    transform: skew(15deg) scaleY(0.6);
  }
  .folder.is-open .folder__front--r {
    transform: skew(-15deg) scaleY(0.6);
  }
  .folder.is-open .folder__paper {
    height: 80%;
    cursor: pointer;
  }
  .folder.is-open .folder__paper.is-current {
    box-shadow: 0 14px 30px -12px rgba(35, 35, 33, 0.35);
  }
  .folder.is-open .folder__label {
    opacity: 0;
  }

  /* caption under the folder: the piece in front */
  .fcard__item {
    display: grid;
    gap: 8px;
    max-width: 46ch;
  }
  .fcard__item[hidden] {
    display: none;
  }
  .fcard__tag {
    justify-self: start;
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    padding: 4px 11px;
    border-radius: 99px;
    background: var(--accent-soft);
  }
  .fcard__item h3 {
    margin: 4px 0 0;
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .fcard__item p {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .fcard__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 6px;
  }
  .fcard__go {
    margin-top: 6px;
    font-size: var(--fs-ui);
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    transition: gap 0.5s var(--ease);
  }
  .fcard__row .fcard__go {
    margin-top: 0;
  }
  .fcard__go:hover {
    gap: 12px;
  }
  .fcard__nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-ui);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .fcard__nav button {
    position: relative;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--hair);
    background: var(--panel);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  /* a 52px tap area around the 30px circle (44px once the desktop zoom applies) */
  .fcard__nav button::after {
    content: '';
    position: absolute;
    inset: -11px;
  }

  @media (max-width: 760px) {
    .folder {
      --w: 210px;
      --h: 168px;
      /* a tighter fan, so the side sheets stay on a phone screen */
      --spread: 26%;
      height: calc(var(--h) + 130px);
    }
  }
  /* phones: no live backdrop blur on moving sheets (iOS Safari flashes black); a frosted tint instead */
  @media (hover: none), (pointer: coarse) {
    .folder__paper {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: linear-gradient(155deg, rgba(250, 253, 252, 0.94), rgba(214, 240, 231, 0.9));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .folder {
      --dur: 0s;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-folder]').forEach((folder) => {
    const card = folder.closest('.fcard')!;
    const hit = folder.querySelector<HTMLButtonElement>('.folder__hit')!;
    const papers = [...folder.querySelectorAll<HTMLElement>('[data-paper]')];
    const captions = [...card.querySelectorAll<HTMLElement>('[data-caption]')];
    const n = papers.length;
    let current = 0;

    // fan the sheets out: the chosen one at the front and centre, the rest leaning away on either side
    const layout = () => {
      const open = folder.classList.contains('is-open');
      papers.forEach((p, i) => {
        p.classList.toggle('is-current', i === current);
        if (!open) {
          // closed: every sheet back inside the folder, stacked
          ['--k', '--ty', '--sc'].forEach((v) => p.style.removeProperty(v));
          p.style.zIndex = '';
          return;
        }
        const k = i - current;
        const far = Math.abs(k);
        p.style.setProperty('--k', String(k));
        p.style.setProperty('--ty', `${i === current ? -92 : -62 + far * 6}%`);
        p.style.setProperty('--sc', `${i === current ? 1 : 0.86}`);
        p.style.zIndex = String(10 - far);
      });
      captions.forEach((c) => (c.hidden = c.dataset.caption !== String(current)));
    };

    // with a mouse, the folder closes when the pointer leaves the card (folder and caption) and opens
    // again when it comes back; on touch it stays open
    const setOpen = (open: boolean) => {
      if (folder.classList.contains('is-open') === open) return;
      folder.classList.toggle('is-open', open);
      hit.setAttribute('aria-expanded', String(open));
      layout();
    };
    card.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') setOpen(false);
    });
    card.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') setOpen(true);
    });
    // keyboard: focus inside the card opens it
    card.addEventListener('focusin', () => setOpen(true));

    // with a mouse, the pointer's position across the folder picks the piece (left third, middle,
    // right third for three pieces) and a click opens it
    folder.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || n < 2) return;
      const r = folder.getBoundingClientRect();
      const i = Math.min(n - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * n)));
      if (i !== current) {
        current = i;
        layout();
      }
    });

    // touch: a sideways swipe of more than 40px moves along; a tap on a side sheet brings it to the
    // middle, and a tap on the middle sheet opens it
    let downX = 0;
    let downY = 0;
    let swiped = false;
    folder.addEventListener('pointerdown', (e) => {
      downX = e.clientX;
      downY = e.clientY;
      swiped = false;
    });
    folder.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' || n < 2) return;
      const dx = e.clientX - downX;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(e.clientY - downY)) {
        swiped = true;
        current = Math.min(n - 1, Math.max(0, current + (dx < 0 ? 1 : -1)));
        layout();
      }
    });

    hit.addEventListener('click', (e) => {
      if (swiped) return;
      const paper = (e.target as HTMLElement).closest<HTMLElement>('[data-paper]');
      const i = paper ? Number(paper.dataset.paper) : current;
      if (i !== current) {
        current = i;
        layout();
        return;
      }
      const href = papers[current]?.dataset.href;
      if (href) location.href = href;
    });
    card.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        current = (current + Number(b.dataset.step) + n) % n;
        layout();
      })
    );
    layout();
  });
</script>
