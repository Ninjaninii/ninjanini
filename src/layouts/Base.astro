---
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;

const fullTitle = title === site.name ? `${site.name} — Designer & Producer` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.domain).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav__pill">
        <a class="nav__brand" href="/">{site.name}</a>
        <nav class="nav__links" aria-label="Main">
          {
            site.nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot" id="contact">
      <div class="shell">
        <div class="foot__grid reveal">
          <div>
            <span class="eyebrow"><i></i>Contact</span>
            <h2 style="margin-top:18px">
              Open to product and brand roles in <span class="serif-it">Singapore</span>.
            </h2>
          </div>
          <ul class="foot__links">
            <li>
              <a href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">&#8599;</span></a>
            </li>
            <li>
              <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn<span aria-hidden="true">&#8599;</span></a>
            </li>
          </ul>
        </div>
        <p class="fine">
          <span>&copy; {new Date().getFullYear()} {site.name}</span>
          <span>Built and maintained by hand</span>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var items = document.querySelectorAll('.reveal');
        if (!items.length || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var el = e.target;
              var delay = Number(el.getAttribute('data-delay') || 0);
              setTimeout(function () {
                el.classList.add('in');
              }, delay);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.06 },
        );
        items.forEach(function (el) {
          io.observe(el);
        });

        // Failsafe: if anything goes wrong, never leave content invisible.
        setTimeout(function () {
          document.documentElement.classList.add('reveal-all');
        }, 1600);
      })();
    </script>
  </body>
</html>
