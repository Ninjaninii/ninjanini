---
import { site } from '../site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;

// Full title used in the browser tab and in Google results.
const fullTitle = title === site.name ? `${site.name} — Designer & Producer` : `${title} — ${site.name}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.domain).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <a class="brand" href="/">{site.name}</a>
      <nav aria-label="Main">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot" id="contact">
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      </ul>
      <p class="fine">© {new Date().getFullYear()} {site.name} · {site.nameZh}</p>
    </footer>
  </body>
</html>

<style is:global>
  /* Structural only. Real design lands in W5 — see the structure spec. */
  :root {
    --ink: #1a1a19;
    --ink-2: #5d5d59;
    --bg: #ffffff;
    --line: #e2e2de;
    --measure: 66ch;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #ededea;
      --ink-2: #a3a39e;
      --bg: #121211;
      --line: #32322f;
    }
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: system-ui, -apple-system, 'Segoe UI', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  img { max-width: 100%; height: auto; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
    background: var(--bg);
    padding: 8px 12px;
    border: 1px solid var(--line);
    z-index: 10;
  }

  .site-head,
  main,
  .site-foot {
    width: min(1000px, 100% - 40px);
    margin-inline: auto;
  }

  .site-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .brand { font-weight: 700; text-decoration: none; margin-right: auto; }
  .site-head nav { display: flex; gap: 16px; }
  .site-head nav a { font-size: 15px; color: var(--ink-2); text-decoration: none; }
  .site-head nav a:hover,
  .site-head nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; }

  main { flex: 1; padding: 40px 0 64px; }
  main > * { max-width: var(--measure); }

  h1 { font-size: clamp(28px, 5vw, 40px); line-height: 1.15; margin: 0 0 12px; letter-spacing: -0.02em; }
  h2 { font-size: 20px; margin: 32px 0 10px; letter-spacing: -0.01em; }
  p { margin: 0 0 14px; color: var(--ink-2); }

  .site-foot { padding: 28px 0 40px; border-top: 1px solid var(--line); }
  .site-foot h2 { font-size: 15px; margin: 0 0 8px; }
  .site-foot ul { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .site-foot a { color: var(--ink-2); }
  .fine { font-size: 13px; color: var(--ink-2); margin: 0; }

  .placeholder {
    border: 1px dashed var(--line);
    padding: 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
